"program voice_rights_v1.aleo;\n\nrecord VoiceIdentity:\n    owner as address.private;\n    voice_commitment as field.private;\n    issuer_commitment as field.private;\n    policy_root as field.private;\n    identity_version as u32.private;\n    issued_licenses as u32.private;\n\nrecord VoiceLicense:\n    owner as address.private;\n    creator as address.private;\n    voice_commitment as field.private;\n    purpose as u8.private;\n    policy_commitment as field.private;\n    expiry_height as u32.private;\n    remaining_uses as u32.private;\n    revocation_id as field.private;\n    license_nonce as field.private;\n\nrecord UsageReceipt:\n    owner as address.private;\n    creator as address.private;\n    voice_commitment as field.private;\n    purpose as u8.private;\n    content_commitment as field.private;\n    policy_commitment as field.private;\n    used_at_height as u32.private;\n    license_nonce as field.private;\n    use_index as u32.private;\n\nstruct RevocationSeed:\n    voice_commitment as field;\n    license_nonce as field;\n\nstruct ReceiptCommitmentSeed:\n    creator as address;\n    voice_commitment as field;\n    purpose as u8;\n    content_commitment as field;\n    policy_commitment as field;\n    used_at_height as u32;\n    license_nonce as field;\n    use_index as u32;\n\nmapping revoked:\n    key as field.public;\n    value as boolean.public;\n\nmapping public_receipts:\n    key as field.public;\n    value as boolean.public;\n\nfunction register_voice:\n    input r0 as field.private;\n    input r1 as field.private;\n    input r2 as field.private;\n    assert.neq r0 0field;\n    assert.neq r1 0field;\n    assert.neq r2 0field;\n    cast self.signer r0 r1 r2 1u32 0u32 into r3 as VoiceIdentity.record;\n    output r3 as VoiceIdentity.record;\n\nfunction issue_license:\n    input r0 as VoiceIdentity.record;\n    input r1 as address.private;\n    input r2 as u8.private;\n    input r3 as field.private;\n    input r4 as u32.private;\n    input r5 as u32.private;\n    input r6 as field.private;\n    assert.eq r0.owner self.signer;\n    gt r2 0u8 into r7;\n    assert.eq r7 true;\n    assert.neq r3 0field;\n    gt r4 0u32 into r8;\n    assert.eq r8 true;\n    gt r5 0u32 into r9;\n    assert.eq r9 true;\n    assert.neq r6 0field;\n    cast r0.voice_commitment r6 into r10 as RevocationSeed;\n    hash.bhp256 r10 into r11 as field;\n    add r0.identity_version 1u32 into r12;\n    add r0.issued_licenses 1u32 into r13;\n    cast r0.owner r0.voice_commitment r0.issuer_commitment r0.policy_root r12 r13 into r14 as VoiceIdentity.record;\n    cast r1 r0.owner r0.voice_commitment r2 r3 r4 r5 r11 r6 into r15 as VoiceLicense.record;\n    output r14 as VoiceIdentity.record;\n    output r15 as VoiceLicense.record;\n\nfunction use_license:\n    input r0 as VoiceLicense.record;\n    input r1 as u8.private;\n    input r2 as field.private;\n    input r3 as u32.private;\n    assert.eq r0.owner self.signer;\n    assert.eq r1 r0.purpose;\n    assert.neq r2 0field;\n    gt r0.remaining_uses 0u32 into r4;\n    assert.eq r4 true;\n    lte r3 r0.expiry_height into r5;\n    assert.eq r5 true;\n    sub r0.remaining_uses 1u32 into r6;\n    cast r0.owner r0.creator r0.voice_commitment r0.purpose r0.policy_commitment r0.expiry_height r6 r0.revocation_id r0.license_nonce into r7 as VoiceLicense.record;\n    cast r0.owner r0.creator r0.voice_commitment r0.purpose r2 r0.policy_commitment r3 r0.license_nonce r6 into r8 as UsageReceipt.record;\n    async use_license r3 r0.revocation_id into r9;\n    output r7 as VoiceLicense.record;\n    output r8 as UsageReceipt.record;\n    output r9 as voice_rights_v1.aleo/use_license.future;\n\nfinalize use_license:\n    input r0 as u32.public;\n    input r1 as field.public;\n    gte block.height r0 into r2;\n    assert.eq r2 true;\n    add r0 120u32 into r3;\n    lte block.height r3 into r4;\n    assert.eq r4 true;\n    get.or_use revoked[r1] false into r5;\n    not r5 into r6;\n    assert.eq r6 true;\n\nfunction revoke_license:\n    input r0 as VoiceIdentity.record;\n    input r1 as field.private;\n    assert.eq r0.owner self.signer;\n    assert.neq r1 0field;\n    cast r0.voice_commitment r1 into r2 as RevocationSeed;\n    hash.bhp256 r2 into r3 as field;\n    async revoke_license r3 into r4;\n    cast r0.owner r0.voice_commitment r0.issuer_commitment r0.policy_root r0.identity_version r0.issued_licenses into r5 as VoiceIdentity.record;\n    output r5 as VoiceIdentity.record;\n    output r4 as voice_rights_v1.aleo/revoke_license.future;\n\nfinalize revoke_license:\n    input r0 as field.public;\n    set true into revoked[r0];\n\nfunction publish_receipt:\n    input r0 as UsageReceipt.record;\n    assert.eq r0.owner self.signer;\n    cast r0.creator r0.voice_commitment r0.purpose r0.content_commitment r0.policy_commitment r0.used_at_height r0.license_nonce r0.use_index into r1 as ReceiptCommitmentSeed;\n    hash.bhp256 r1 into r2 as field;\n    assert.neq r2 0field;\n    async publish_receipt r2 into r3;\n    output r2 as field.private;\n    output r3 as voice_rights_v1.aleo/publish_receipt.future;\n\nfinalize publish_receipt:\n    input r0 as field.public;\n    set true into public_receipts[r0];\n\nconstructor:\n    assert.eq edition 0u16;\n"