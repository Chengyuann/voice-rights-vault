    input r0 as VoiceIdentity.record;\n    input r1 as address.private;\n    input r2 as u8.private;\n    input r3 as field.private;\n    input r4 as u32.private;\n    input r5 as u32.private;\n    input r6 as field.private;\n    assert.eq r0.owner self.signer;\n    gt r2 0u8 into r7;\n    assert.eq r7 true;\n    assert.neq r3 0field;\n    gt r4 0u32 into r8;\n    assert.eq r8 true;\n    gt r5 0u32 into r9;\n    assert.eq r9 true;\n    assert.neq r6 0field;\n    cast r0.voice_commitment r6 into r10 as RevocationSeed;\n    hash.bhp256 r10 into r11 as field;\n    add r0.identity_version 1u32 into r12;\n    add r0.issued_licenses 1u32 into r13;\n    cast r0.owner r0.voice_commitment r0.issuer_commitment r0.policy_root r12 r13 into r14 as VoiceIdentity.record;\n    cast r1 r0.owner r0.voice_commitment r2 r3 r4 r5 r11 r6 into r15 as VoiceLicense.record;\n    output r14 as VoiceIdentity.record;\n    output r15 as VoiceLicense.record;\n\nfunction use_license:\n    input r0 as VoiceLicense.record;\n    input r1 as u8.private;\n    input r2 as field.private;\n    input r3 as u32.private;\n    assert.eq r0.owner self.signer;\n    assert.eq r1 r0.purpose;\n    assert.neq r2 0field;\n    gt r0.remaining_uses 0u32 into r4;\n    assert.eq r4 true;\n    lte r3 r0.expiry_height into r5;\n    assert.eq r5 true;\n    sub r0.remaining_uses 1u32 into r6;\n    cast r0.owner r0.creator r0.voice_commitment r0.purpose r0.policy_commitment r0.expiry_height r6 r0.revocation_id r0.license_nonce into r7 as VoiceLicense.record;\n    cast r0.owner r0.creator r0.voice_commitment r0.purpose r2 r0.policy_commitment r3 r0.license_nonce r6 into r8 as UsageReceipt.record;\n    async use_license r3 r0.revocation_id into r9;\n    output r7 as VoiceLicense.record;\n    output r8 as UsageReceipt.record;\n    output r9 as voice_rights_v1.aleo/use_license.future;\n\nfinalize use_license:\n    input r0 as u32.public;\n    input r1 as field.public;\n    gte block.height r0 into r2;\n    assert.eq r2 true;\n    add r0 120u32 into r3;\n    lte block.height r3 into r4;\n    assert.eq r4 true;\n    get.or_use revoked[r1] false into r5;\n    not r5 into r6;\n    assert.eq r6 true;\n\nfunction revoke_license:\n    input r0 as VoiceIdentity.record;\n    input r1 as field.private;\n    assert.eq r0.owner self.signer;\n    assert.neq r1 0field;\n    cast r0.voice_commitment r1 into r2 as RevocationSeed;\n    hash.bhp256 r2 into r3 as field;\n    async revoke_license r3 into r4;\n    cast r0.owner r0.voice_commitment r0.issuer_commitment r0.policy_root r0.identity_version r0.issued_licenses into r5 as VoiceIdentity.record;\n    output r5 as VoiceIdentity.record;\n    output r4 as voice_rights_v1.aleo/revoke_license.future;\n\nfinalize revoke_license:\n    input r0 as field.public;\n    set true into revoked[r0];\n\nfunction publish_receipt:\n    input r0 as UsageReceipt.record;\n    assert.eq r0.owner self.signer;\n    cast r0.creator r0.voice_commitment r0.purpose r0.content_commitment r0.policy_commitment r0.used_at_height r0.license_nonce r0.use_index into r1 as ReceiptCommitmentSeed;\n    hash.bhp256 r1 into r2 as field;\n    assert.neq r2 0field;\n    async publish_receipt r2 into r3;\n    output r2 as field.private;\n    output r3 as voice_rights_v1.aleo/publish_receipt.future;\n\nfinalize publish_receipt:\n    input r0 as field.public;\n    set true into public_receipts[r0];\n\nconstructor:\n    assert.eq edition 0u16;\n,program_owner:aleo157paujr5h54grzxt3t2ggw2gxun29gu8eh9q3dxkvffvp87f5yzs3lmcwy,verifying_keys:[[register_voice,[,certificate1qyqsqqqqqqqqqqpjmyc8wrtr4uyartmgpe2clcs3dq5ah67s6cjcw48p2nl0kvu80mspzlvusg7jqh37x9t4p9e8yqqsq8j5gjs]],[issue_license,[,certificate1qyqsqqqqqqqqqqqkg07h8ka0zzfj0ssur8j3kjk20l35wcz7mhezd6u6uhnzyw4qdr8wf86eg9cpd8w3e096v4e6dgqsq0m0s42]],[use_license,[,certificate1qyqsqqqqqqqqqqq6vdp5z72zq3rhz4xt2xkaye3kkv9p5hhurq7zneznt972m8vg8fzjnqvm630pvq684ttva3mrjkqsq3vhnhj]],[revoke_license,[,certificate1qyqsqqqqqqqqqqyjlcuua3uvxfk6dnsmpw63sgwrgleu4t